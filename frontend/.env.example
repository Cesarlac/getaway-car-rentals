# Copie este arquivo para ".env" e preencha. O Vite só lê o .env ao iniciar.

# URL pública do bucket "carros" no Supabase Storage (obrigatória)
VITE_FOTOS_URL=https://<REF_DO_PROJETO>.supabase.co/storage/v1/object/public/carros

# URL base do back-end, sem /api (opcional; padrão: http://localhost:8080)
# VITE_API_URL=http://localhost:8080

# Vídeo de fundo do login e do cadastro (opcional; sem ele, o fundo usa as ondas animadas)
# VITE_VIDEO_LOGIN_URL=https://<REF_DO_PROJETO>.supabase.co/storage/v1/object/public/public-assets/video-login-cadastro.mp4

# Imagem mostrada enquanto o vídeo carrega (opcional)
# VITE_VIDEO_LOGIN_POSTER=
